# Server
PORT=3000
NODE_ENV=development

# Base URL (for OAuth redirects and widget). Use https://chat.elevatedroofingandsiding.com in production.
BASE_URL=http://localhost:3000

# Google Cloud - Chat (service account JSON path or leave empty to use GOOGLE_APPLICATION_CREDENTIALS)
GOOGLE_CHAT_CREDENTIALS_PATH=../elevated-roofing-website-chat-d56faccd129d.json

# Google Chat space ID (from the space URL: .../chat/AAQAJjD8_Ho)
GOOGLE_CHAT_SPACE_ID=AAQAJjD8_Ho

# Admin - Google OAuth 2.0 (create in Cloud Console: APIs & Services > Credentials > Create OAuth 2.0 Client ID > Web application)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Optional: restrict admin to these emails (comma-separated) or domain (e.g. elevatedroofingandsiding.com)
ALLOWED_ADMIN_EMAILS=
ALLOWED_ADMIN_DOMAIN=

# Session secret (generate a random string for production)
SESSION_SECRET=change-me-to-a-random-string

# Polling interval in ms for syncing agent replies from Google Chat (default 15000 = 15s)
CHAT_POLL_INTERVAL_MS=15000
