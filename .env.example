# Copy to .env and fill in. Used by docker-compose.

BASE_URL=https://chat.elevatedroofingandsiding.com
GOOGLE_CHAT_SPACE_ID=AAQAJjD8_Ho
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
ALLOWED_ADMIN_EMAILS=
# Comma-separated domains allowed to sign in (e.g. elevatedroofingandsiding.com,elevated-roofing.com)
ALLOWED_ADMIN_DOMAIN=elevatedroofingandsiding.com,elevated-roofing.com
SESSION_SECRET=generate-a-long-random-string
CHAT_POLL_INTERVAL_MS=15000
